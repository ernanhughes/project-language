{
  "name": "project-language",
  "private": true,
  "type": "module",
  "description": "Runnable capabilities for the Language book: host-independent core, thin Pi host adapter.",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --experimental-transform-types --test \"core/**/*.test.ts\" \"host-pi/**/*.test.ts\"",
    "test:skeleton": "node --experimental-transform-types --test \"core/authority/tests/*.test.ts\" \"host-pi/*.test.ts\"",
    "verify": "npm run typecheck && npm test",
    "example:ch07": "node --experimental-transform-types --disable-warning=ExperimentalWarning examples/ch07-record/ch07.ts",
    "example:conversation-state": "node --experimental-transform-types --disable-warning=ExperimentalWarning examples/conversation-state/conversation-state.ts",
    "example:ch08": "node --experimental-transform-types --disable-warning=ExperimentalWarning examples/ch08-sidecar/ch08.ts",
    "example:ch09": "node --experimental-transform-types --disable-warning=ExperimentalWarning examples/ch09-relations/ch09.ts",
    "example:ch10": "node --experimental-transform-types --disable-warning=ExperimentalWarning examples/ch10-preservation/ch10.ts",
    "example:ch11": "node --experimental-transform-types --disable-warning=ExperimentalWarning examples/ch11-ladder/ch11.ts",
    "example:ch12": "node --experimental-transform-types --disable-warning=ExperimentalWarning examples/ch12-browser/ch12.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  },
  "optionalDependencies": {
    "pg": "^8.23.1"
  }
}
