+import {z} from 'zod';
+import {loadCorpus} from '../qualification/corpus.mjs';import {CASES} from '../negotiated-v1/protocol.mjs';import {hash} from '../qualification/contracts.mjs';
+export function anchors(source){let cursor=0;return source.split('\n\n').map((quote,i)=>{const start=source.indexOf(quote,cursor);cursor=start+quote.length;return {id:'s'+(i+1),start,end:cursor,quote};});}
+export function buildPack(){
+ const inputs=[...loadCorpus().map(t=>({origin:t.id,source:t.source,questions:t.questions,proposed:t.reference})),...CASES.map(c=>({origin:'WB/'+c.id,source:'ORIGINAL EXPRESSION\n'+c.expression+'\n\nRECORDED CLARIFICATION — SIMULATED_HUMAN\n'+c.clarification,questions:[{id:'application',text:c.question}],proposed:[{question_id:'application',supported_decisions:[c.expected],rationale:'Apply the clarified condition while retaining independent constraints; no simulated semantic acceptance grants action authority.',permitted_alternatives:['A source-supported qualified answer documented by independent reviewers before execution.'],critical_distinctions:[c.constraint,c.resolved?'Recorded condition and retained boundary are distinct.':'Unresolved evidence is not permission or evidence of falsity.'],unsupported_controls:['Resolving a condition silently grants unrelated action authority.'],abstention_conditions:['Use UNKNOWN when the accepted source bundle leaves a decisive question unresolved; distinguish capacity limitations.']}]}))];
+ const tasks=inputs.map((t,i)=>({id:'T'+String(i+1).padStart(3,'0'),source:t.source,source_hash:hash(t.source),objective:'Communicate the source-supported distinctions needed to answer the receiver question(s), preserving exceptions, uncertainty and authority limits.',questions:t.questions,anchors:anchors(t.source),standing:'PROPOSED_UNADJUDICATED'}));
+ const publicPack={schema:'transfer-human-source-pack/1',status:'HUMAN_REVIEW_PENDING',blind_to:['model identities','experimental arm','other reviewer decisions','author proposed answer key','model outputs'],tasks};
+ const pack_hash=hash(publicPack);
+ const hostKey={schema:'transfer-author-key/1',pack_hash,standing:'PROPOSED_UNADJUDICATED_NOT_HUMAN_GOLD',process_sealed_not_encrypted:true,tasks:inputs.map((x,i)=>({id:tasks[i].id,origin:x.origin,source_hash:tasks[i].source_hash,proposed:x.proposed,anchors:tasks[i].anchors}))};
+ const template=slot=>({schema:'transfer-human-review/1',slot,pack_hash,reviewer_identity:null,submitted_at:null,attestations:{human_origin:null,other_review_not_seen:null,author_key_not_seen_before_submission:null},tasks:tasks.map(t=>({id:t.id,source_hash:t.source_hash,judgments:t.questions.map(q=>({question_id:q.id,decision:null,rationale:null,support_anchor_ids:[],critical_qualifications:[],acceptable_alternatives:[],unsupported_assertions:[],critical_omissions:[],abstention_conditions:[],question_ambiguous:null,uncertainty_notes:null,disagreement_notes:null}))}))});
+ return {publicPack,pack_hash,hostKey,templates:[template('R1'),template('R2')]};
+}
+export const Review=z.object({schema:z.literal('transfer-human-review/1'),slot:z.enum(['R1','R2']),pack_hash:z.string(),reviewer_identity:z.string().min(1).nullable(),submitted_at:z.string().nullable(),attestations:z.object({human_origin:z.boolean().nullable(),other_review_not_seen:z.boolean().nullable(),author_key_not_seen_before_submission:z.boolean().nullable()}).strict(),tasks:z.array(z.object({id:z.string(),source_hash:z.string(),judgments:z.array(z.object({question_id:z.string(),decision:z.enum(['YES','NO','UNKNOWN','SOURCE_CONFLICT','QUESTION_DEFECT']).nullable(),rationale:z.string().nullable(),support_anchor_ids:z.array(z.string()),critical_qualifications:z.array(z.string()),acceptable_alternatives:z.array(z.string()),unsupported_assertions:z.array(z.string()),critical_omissions:z.array(z.string()),abstention_conditions:z.array(z.string()),question_ambiguous:z.boolean().nullable(),uncertainty_notes:z.string().nullable(),disagreement_notes:z.string().nullable()}).strict())}).strict())}).strict();
+export function inspectReview(value,pack=buildPack()){
+ const r=Review.parse(value);if(r.pack_hash!==pack.pack_hash)throw Error('REVIEW_PACK_HASH');
+ if(r.tasks.length!==pack.publicPack.tasks.length||new Set(r.tasks.map(x=>x.id)).size!==r.tasks.length)throw Error('REVIEW_TASK_COVERAGE');
