{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "answers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "YES",
              "NO",
              "UNKNOWN",
              "SOURCE_CONFLICT"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "quotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "decision",
          "explanation",
          "quotes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "answers"
  ],
  "additionalProperties": false
}