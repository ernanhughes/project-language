{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "DECLARED",
        "OBSERVED",
        "INFERRED"
      ]
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "RETRACTED"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "expires": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "permission": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "const": "transfer-01b"
        },
        "recipient": {
          "type": "string",
          "const": "B"
        },
        "transmit": {
          "type": "boolean"
        }
      },
      "required": [
        "purpose",
        "recipient",
        "transmit"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "supported": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "kind",
    "origin",
    "status",
    "scope",
    "expires",
    "permission",
    "version",
    "conflicts",
    "text",
    "supported"
  ],
  "additionalProperties": false
}