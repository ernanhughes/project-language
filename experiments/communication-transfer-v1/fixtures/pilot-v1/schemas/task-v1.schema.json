{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "transfer-pilot-task/1"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "family": {
      "type": "string",
      "enum": [
        "technical-policy",
        "research-interpretation"
      ]
    },
    "standing": {
      "type": "string",
      "const": "PROPOSED_UNADJUDICATED"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string"
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "quote",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "plain_message": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "supported_decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "YES",
                "NO",
                "UNKNOWN",
                "SOURCE_CONFLICT"
              ]
            }
          },
          "rationale": {
            "type": "string"
          },
          "permitted_alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "critical_distinctions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unsupported_controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "abstention_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "question_id",
          "supported_decisions",
          "rationale",
          "permitted_alternatives",
          "critical_distinctions",
          "unsupported_controls",
          "abstention_conditions"
        ],
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "object",
      "properties": {
        "task_author": {
          "type": "object",
          "properties": {
            "identity": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "approved": {
              "type": "boolean"
            },
            "at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_hash": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "identity",
            "approved",
            "at",
            "source_hash"
          ],
          "additionalProperties": false
        },
        "independent_reviewer": {
          "type": "object",
          "properties": {
            "identity": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "approved": {
              "type": "boolean"
            },
            "at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_hash": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "identity",
            "approved",
            "at",
            "source_hash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "task_author",
        "independent_reviewer"
      ],
      "additionalProperties": false
    },
    "training_absence": {
      "type": "string",
      "const": "NOT_KNOWN"
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "family",
    "standing",
    "source",
    "source_hash",
    "questions",
    "claims",
    "plain_message",
    "reference",
    "approvals",
    "training_absence"
  ],
  "additionalProperties": false
}