{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "supported": {
      "type": "boolean"
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "valid_abstention": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "supported",
    "unsupported_claims",
    "valid_abstention",
    "rationale"
  ],
  "additionalProperties": false
}