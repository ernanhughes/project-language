{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "transfer-human-review/1"
    },
    "slot": {
      "type": "string",
      "enum": [
        "R1",
        "R2"
      ]
    },
    "pack_hash": {
      "type": "string"
    },
    "reviewer_identity": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "submitted_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "attestations": {
      "type": "object",
      "properties": {
        "human_origin": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "other_review_not_seen": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "author_key_not_seen_before_submission": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "human_origin",
        "other_review_not_seen",
        "author_key_not_seen_before_submission"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source_hash": {
            "type": "string"
          },
          "judgments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question_id": {
                  "type": "string"
                },
                "decision": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "YES",
                        "NO",
                        "UNKNOWN",
                        "SOURCE_CONFLICT",
                        "QUESTION_DEFECT"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rationale": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "support_anchor_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "critical_qualifications": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "acceptable_alternatives": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "unsupported_assertions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "critical_omissions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "abstention_conditions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "question_ambiguous": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "uncertainty_notes": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "disagreement_notes": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "question_id",
                "decision",
                "rationale",
                "support_anchor_ids",
                "critical_qualifications",
                "acceptable_alternatives",
                "unsupported_assertions",
                "critical_omissions",
                "abstention_conditions",
                "question_ambiguous",
                "uncertainty_notes",
                "disagreement_notes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "source_hash",
          "judgments"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "slot",
    "pack_hash",
    "reviewer_identity",
    "submitted_at",
    "attestations",
    "tasks"
  ],
  "additionalProperties": false
}